---
import ElementorImage from "@/assets/images/liftlink_elementor.png";
import { Image } from "astro:assets";
---

<section
  class="relative w-full bg-black py-40 md:py-56 px-6 md:px-12 overflow-hidden"
  id="feature-section"
>
  <div
    class="max-w-7xl mx-auto flex flex-col md:flex-row gap-12 md:gap-24 items-start"
  >
    <div class="w-full md:w-1/2 z-10 feature-text opacity-0">
      <h2
        class="font-satoshi text-5xl md:text-7xl lg:text-6xl text-white tracking-tighter mb-12 md:mb-8"
      >
        Diseñado <br /><span class="text-gray-500">para rendimiento</span>
      </h2>
      <p
        class="font-satoshi tracking-tighter text-gray-400 text-lg md:text-xl lg:text-2xl"
      >
        Todo el poder de la ecualización underground en la palma de tu mano.
      </p>
    </div>

    <div class="relative z-10 w-full md:w-1/2 flex justify-center lg:-translate-y-12 xl:-translate-y-16">
      <!-- Glow effect optimizado (Radial gradient en lugar de blur para 60fps) -->
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_center,_rgba(255,255,255,0.15)_0%,_transparent_70%)] -z-10 scale-110"
      >
      </div>

      <div class="feature-image opacity-0 w-full will-change-transform">
        <Image
          src={ElementorImage}
          alt="LiftLink App Interface"
          width={1200}
          format="webp"
          quality={100}
          class="w-full h-auto"
        />
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    // Animación masiva atada al scroll (scrub)
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "#feature-section",
        start: "top 85%", // Inicia cuando la sección entra por abajo
        end: "center center", // Termina cuando la sección llega al centro
        scrub: 1, // Suavizado de 1 segundo para atarlo al scroll
      },
    });

    // El texto viene desde la izquierda, escalándose
    tl.fromTo(
      ".feature-text",
      { x: -150, opacity: 0, scale: 0.8 },
      { x: 0, opacity: 1, scale: 1, ease: "power2.out" },
      0,
    );

    // La imagen viene desde abajo, escalándose masivamente
    tl.fromTo(
      ".feature-image",
      { y: 200, opacity: 0, scale: 0.7 },
      { y: 0, opacity: 1, scale: 1, ease: "power2.out" },
      0,
    );
  });
</script>
