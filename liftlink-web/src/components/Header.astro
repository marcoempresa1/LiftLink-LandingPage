---
import { Image } from "astro:assets";
import Logo from "@/assets/images/header.png";
import Noise from "@/components/Noise";
---

<header
  class="absolute top-0 left-0 w-full z-50 transition-all duration-300 bg-gradient-to-b from-black/90 to-transparent text-white pt-4 pb-8"
>
  <nav
    class="mx-auto flex max-w-7xl items-center font-satoshi justify-between px-6 py-6 uppercase text-white md:px-12"
  >
    <Image
      src={Logo}
      alt="LiftLink Logo"
      width={140}
      format="png"
      quality="highest"
      class="w-[90px] xl: lg: md:w-[140px] sm:w-[130px]"
    />
    <ul class="flex items-center gap-1.5 sm:gap-2 md:gap-3 text-sm font-medium">
      <li>
        <a
          href="/"
          class="group flex items-center gap-1.5 md:gap-3 rounded-full bg-white py-1 md:py-2 pl-3 md:pl-5 pr-1 md:pr-2 text-black transition hover:bg-gray-200"
        >
          <span
            class="text-[10px] sm:text-xs md:text-sm font-medium tracking-tight"
            >Desarrollador</span
          >
          <span
            class="flex h-5 w-5 sm:h-6 sm:w-6 md:h-8 md:w-8 items-center justify-center rounded-full bg-black text-[10px] md:text-lg text-white transition-transform group-hover:rotate-45"
          >
            ↗
          </span>
        </a>
      </li>

      <li>
        <a
          href="/"
          class="group flex items-center gap-1.5 md:gap-3 rounded-full bg-white py-1 md:py-2 pl-3 md:pl-5 pr-1 md:pr-2 text-black transition hover:bg-gray-200"
        >
          <span
            class="text-[10px] sm:text-xs md:text-sm font-medium tracking-tight"
            >Contacto</span
          >
          <span
            class="flex h-5 w-5 sm:h-6 sm:w-6 md:h-8 md:w-8 items-center justify-center rounded-full bg-black text-[10px] md:text-lg text-white transition-transform group-hover:rotate-45"
          >
            ↗
          </span>
        </a>
      </li>
    </ul>
  </nav>
</header>
