---
import LineartImage from "@/assets/images/lineart.png";
import NoLineartImage from "@/assets/images/nolineart.png";
import { Image } from "astro:assets";
---

<section
  id="scroll-sequence-wrapper"
  class="relative w-full bg-[#000000] h-auto md:h-[300vh] -mt-[5vh] md:-mt-[15vh] z-20"
>
  <div
    class="relative md:sticky top-0 w-full h-auto md:h-screen overflow-hidden px-6 md:px-12 py-20 md:pt-0"
  >
    <!-- Inner Wrapper to translate up on mobile -->
    <div class="sequence-inner-wrapper w-full h-full flex flex-col md:flex-row items-center justify-start md:justify-center">
      <!-- Image Container -->
      <div
        class="sequence-image-container relative w-full max-w-[280px] md:max-w-[240px] lg:max-w-[280px] flex-shrink-0 z-20 mx-auto md:mt-0"
      >
        <!-- Lineart (Base) -->
        <Image
          src={LineartImage}
          alt="Lineart Phone"
          width={600}
          format="webp"
          quality={100}
          class="w-full h-auto block"
          loading="eager"
          decoding="async"
        />
        <!-- No Lineart (Fills in on top) -->
        <Image
          src={NoLineartImage}
          alt="Filled Phone"
          width={600}
          format="webp"
          quality={100}
          class="nolineart-image absolute left-1/2 -translate-x-1/2 -translate-y-1/2 max-w-none h-auto opacity-0 w-full"
          style="top: 50%; "
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Text Block (Hidden initially on desktop, static on mobile) -->
      <div
        class="sequence-text-block block relative md:absolute mt-8 md:mt-0 right-auto md:right-8 lg:right-20 w-full max-w-sm md:max-w-lg lg:max-w-2xl opacity-100 translate-x-0 md:opacity-0 md:translate-x-12 z-10"
      >
        <div
          class="sequence-reveal-item opacity-100 md:opacity-20 mb-6 border-b border-white/10 pb-4"
        >
          <h3
            class="font-satoshi text-4xl lg:text-5xl text-white tracking-tighter"
          >
            Pega la URL de tu video favorito <br /><span class="text-gray-500"
              >y exporta fácilmente</span
            >
          </h3>
        </div>

        <div
          class="grid grid-cols-2 gap-8 mb-8 sequence-reveal-item opacity-100 md:opacity-20 text-gray-400 text-sm font-satoshi"
        >
          <p>
            LiftLink construye un entorno cerrado sin anuncios para que puedas
            concentrarte al máximo en tu entrenamiento.
          </p>
          <p>
            Reproduce con gran calidad — luego organiza tu audio dentro de una
            lista de reproducción, en el estilo que elijas.
          </p>
        </div>

        <div
          class="w-full sequence-reveal-item opacity-100 md:opacity-20"
        >
          <!-- Card 1: Sleek Music Player -->
          <div
            class="w-full bg-[#121212] border border-white/5 rounded-2xl p-4 md:p-5 flex flex-col justify-center relative overflow-hidden uppercase font-satoshi"
          >
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 md:w-14 md:h-14 rounded-xl bg-white/10 flex-shrink-0"></div>
              <div>
                <h4 class="text-white text-base md:text-lg font-medium leading-tight mb-1">
                  Music 1
                </h4>
                <p class="text-gray-500 text-[10px] md:text-xs">Playlist</p>
              </div>
            </div>

            <div class="w-full flex items-center gap-3 mb-5">
              <span class="text-[9px] md:text-[10px] text-gray-500 font-satoshi">0:45</span>
              <input
                type="range"
                min="0"
                max="100"
                value="30"
                class="flex-1 h-1 bg-white/10 rounded-full appearance-none cursor-pointer accent-white hover:accent-gray-300 transition-all"
              />
              <span class="text-[9px] md:text-[10px] text-gray-500 font-satoshi">-2:15</span>
            </div>

            <div class="flex justify-center items-center gap-6">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="currentColor"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-gray-500 hover:text-white transition-colors cursor-pointer"
                ><polygon points="19 20 9 12 19 4 19 20"></polygon><line
                  x1="5"
                  y1="19"
                  x2="5"
                  y2="5"></line></svg
              >
              <div
                class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-white text-black flex items-center justify-center cursor-pointer hover:scale-105 transition-transform"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="ml-0.5"
                  ><polygon points="5 3 19 12 5 21 5 3"></polygon></svg
                >
              </div>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="currentColor"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-gray-500 hover:text-white transition-colors cursor-pointer"
                ><polygon points="5 4 15 12 5 20 5 4"></polygon><line
                  x1="19"
                  y1="5"
                  x2="19"
                  y2="19"></line></svg
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    // Media query para animaciones diferentes en móvil vs desktop
    let mm = gsap.matchMedia();

    mm.add("(min-width: 768px)", () => {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: "#scroll-sequence-wrapper",
          start: "top top",
          end: "bottom bottom",
          scrub: 1, // Smooth scrubbing
        },
      });

      // Frame 0: Pausa inicial para que el usuario aprecie el lineart blanco
      tl.to({}, { duration: 1 })

        // Fase 1: Fade in de la imagen rellena
        .to(".nolineart-image", { opacity: 1, duration: 2 })

        // Fase 2: Mover la imagen a la izquierda de forma responsiva
        .to(".sequence-image-container", { x: "-25vw", duration: 2 }, "+=0.5")

        // Fase 3: Aparecer el contenedor general
        .to(".sequence-text-block", { opacity: 1, x: 0, duration: 1 }, "<")

        // Fase 4: Revelar el texto secuencialmente iluminándolo
        .to(".sequence-reveal-item", { opacity: 1, duration: 2, stagger: 1.5 });
    });

    mm.add("(max-width: 767px)", () => {
      // Sin animación de scroll, solo un pequeño fade-in cuando el celular entra en vista
      gsap.to(".nolineart-image", {
        scrollTrigger: {
          trigger: ".sequence-image-container",
          start: "top 75%",
        },
        opacity: 1,
        duration: 1.5,
        ease: "power2.out",
      });
    });
  });
</script>
