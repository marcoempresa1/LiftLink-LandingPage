---
import LineartImage from "@/assets/images/lineart.png";
import NoLineartImage from "@/assets/images/nolineart.png";
import { Image } from "astro:assets";
---

<section
  id="scroll-sequence-wrapper"
  class="relative w-full bg-[#000000] h-[300vh] -mt-[15vh] z-20"
>
  <div
    class="sticky top-0 w-full h-screen overflow-hidden flex flex-col md:flex-row items-center justify-center px-6 md:px-12 pt-20 md:pt-0"
  >
    <!-- Image Container -->
    <div
      class="sequence-image-container relative w-full max-w-[140px] md:max-w-[240px] lg:max-w-[280px] flex-shrink-0 z-20 mx-auto"
    >
      <!-- Lineart (Base) -->
      <Image
        src={LineartImage}
        alt="Lineart Phone"
        width={600}
        format="webp"
        quality={100}
        class="w-full h-auto block"
      />
      <!-- No Lineart (Fills in on top) -->
      <Image
        src={NoLineartImage}
        alt="Filled Phone"
        width={600}
        format="webp"
        quality={100}
        class="nolineart-image absolute left-1/2 -translate-x-1/2 -translate-y-1/2 max-w-none h-auto opacity-0 w-full"
        style="top: 50%; "
      />
    </div>

    <!-- Text Block (Hidden initially, slides in from right) -->
    <div
      class="sequence-text-block relative md:absolute mt-8 md:mt-0 right-auto md:right-8 lg:right-20 w-full max-w-sm md:max-w-lg lg:max-w-2xl opacity-0 translate-x-12 z-10 block"
    >
      <div
        class="sequence-reveal-item opacity-20 mb-6 border-b border-white/10 pb-4"
      >
        <h3
          class="font-satoshi text-4xl lg:text-5xl text-white tracking-tighter"
        >
          Pega la URL de tu video favorito <br /><span class="text-gray-500"
            >y exporta fácilmente</span
          >
        </h3>
      </div>

      <div
        class="grid grid-cols-2 gap-8 mb-8 sequence-reveal-item opacity-20 text-gray-400 text-sm font-satoshi"
      >
        <p>
          LiftLink construye un entorno cerrado sin anuncios para que puedas
          concentrarte al máximo en tu entrenamiento.
        </p>
        <p>
          Reproduce con gran calidad — luego organiza tu audio dentro de una
          lista de reproducción, en el estilo que elijas.
        </p>
      </div>

      <div class="grid grid-cols-5 gap-4 mb-4 sequence-reveal-item opacity-20">
        <!-- Card 1: Music Player -->
        <div
          class="col-span-2 bg-[#121212] border border-white/5 rounded-3xl p-5 flex flex-col justify-center relative overflow-hidden uppercase font-satoshi"
        >
          <div class="flex items-center gap-4 mb-6">
            <div class="w-16 h-16 rounded-xl bg-white/10 flex-shrink-0"></div>
            <div>
              <h4 class="text-white text-base font-medium leading-tight mb-1">
                Music 1
              </h4>
              <p class="text-gray-500 text-xs">Playlist</p>
            </div>
          </div>

          <div class="w-full flex items-center gap-3 mb-6">
            <span class="text-[10px] text-gray-500 font-satoshi">0:45</span>
            <input
              type="range"
              min="0"
              max="100"
              value="30"
              class="flex-1 h-1 bg-white/10 rounded-full appearance-none cursor-pointer accent-white hover:accent-gray-300 transition-all"
            />
            <span class="text-[10px] text-gray-500 font-satoshi">-2:15</span>
          </div>

          <div class="flex justify-center items-center gap-8">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-gray-500 hover:text-white transition-colors cursor-pointer"
              ><polygon points="19 20 9 12 19 4 19 20"></polygon><line
                x1="5"
                y1="19"
                x2="5"
                y2="5"></line></svg
            >
            <div
              class="w-12 h-12 rounded-full bg-white text-black flex items-center justify-center cursor-pointer hover:scale-105 transition-transform"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="currentColor"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="ml-1"
                ><polygon points="5 3 19 12 5 21 5 3"></polygon></svg
              >
            </div>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-gray-500 hover:text-white transition-colors cursor-pointer"
              ><polygon points="5 4 15 12 5 20 5 4"></polygon><line
                x1="19"
                y1="5"
                x2="19"
                y2="19"></line></svg
            >
          </div>
        </div>

        <!-- Card 2: URL Input & Processing -->
        <div
          class="col-span-3 bg-[#121212] border border-white/5 rounded-3xl p-6 flex flex-col justify-center"
        >
          <span
            class="text-[10px] text-gray-500 uppercase font-medium tracking-wider mb-4 block font-satoshi"
            >URL DEL VIDEO</span
          >

          <div
            class="bg-[#0a0a0a] border border-white/10 rounded-xl p-2 flex items-center mb-8"
          >
            <div
              class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center mr-3"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4 text-gray-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path
                  d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
                ></path><path
                  d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
                ></path></svg
              >
            </div>
            <span
              class="text-xs text-gray-400 font-mono truncate mr-2 font-satoshi"
              >https://tiktok.com/@user/video/1234567890</span
            >
            <div
              class="ml-auto bg-white text-black text-xs px-5 py-2 rounded-lg font-medium cursor-pointer hover:bg-gray-200 transition-colors font-satoshi"
            >
              Extraer
            </div>
          </div>

          <div class="space-y-6">
            <div class="flex items-center justify-between">
              <span
                class="text-[10px] text-white font-mono px-3 py-1 bg-white/5 rounded-full font-satoshi"
                >BASS BOOST</span
              >
              <!-- Minimalist Range Slider instead of toggle -->
              <input
                type="range"
                min="0"
                max="100"
                value="80"
                class="w-[140px] h-1 bg-white/10 rounded-full appearance-none cursor-pointer accent-white hover:accent-gray-300 transition-all"
              />
            </div>
            <div class="flex items-center justify-between">
              <span
                class="text-[10px] text-white px-3 py-1 bg-white/5 rounded-full font-satoshi"
                >REVERB</span
              >
              <!-- Minimalist Range Slider -->
              <input
                type="range"
                min="0"
                max="100"
                value="10"
                class="w-[140px] h-1 bg-white/10 rounded-full appearance-none cursor-pointer accent-gray-500 hover:accent-white transition-all"
              />
            </div>
          </div>
        </div>
      </div>

      <div
        class="bg-gradient-to-r from-white/5 to-transparent border border-white/10 rounded-2xl p-5 flex justify-center items-center sequence-reveal-item opacity-20"
      >
        <p
          class="text-xs text-gray-400 font-satoshi uppercase tracking-widest text-center"
        >
          Transforma cualquier video en tu próximo récord personal
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    // Media query para animaciones diferentes en móvil vs desktop
    let mm = gsap.matchMedia();

    mm.add("(min-width: 768px)", () => {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: "#scroll-sequence-wrapper",
          start: "top top",
          end: "bottom bottom",
          scrub: 1, // Smooth scrubbing
        },
      });

      // Fase 1: Fade in de la imagen rellena
      tl.to(".nolineart-image", { opacity: 1, duration: 2 })

        // Fase 2: Mover la imagen a la izquierda de forma responsiva (25% del ancho de la pantalla)
        .to(".sequence-image-container", { x: "-25vw", duration: 2 }, "+=0.5")

        // Fase 3: Aparecer el contenedor general
        .to(".sequence-text-block", { opacity: 1, x: 0, duration: 1 }, "<")

        // Fase 4: Revelar el texto secuencialmente iluminándolo
        .to(".sequence-reveal-item", { opacity: 1, duration: 2, stagger: 1.5 });
    });

    mm.add("(max-width: 767px)", () => {
      // En móvil, hacemos el fade in y escalamos, sin mover a la izquierda
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: "#scroll-sequence-wrapper",
          start: "top top",
          end: "bottom bottom",
          scrub: 1,
        },
      });

      tl.to(".nolineart-image", { opacity: 1, duration: 2 })
        .to(".sequence-image-container", { scale: 1.05, duration: 2 }, "+=0.5")
        // Revelar el contenedor de texto en móvil
        .to(".sequence-text-block", { opacity: 1, x: 0, duration: 1 }, "<")
        // Iluminar las tarjetas secuencialmente
        .to(".sequence-reveal-item", { opacity: 1, duration: 2, stagger: 1.5 });
    });
  });
</script>
