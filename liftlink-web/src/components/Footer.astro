---

---

<footer
  class="relative w-full bg-[#050505] overflow-hidden pt-32 pb-8 px-6 md:px-12 flex flex-col items-center"
>
  <!-- Contact / Developer Section -->
  <div
    class="w-full max-w-7xl mx-auto flex flex-col items-center text-center mb-32 z-10"
  >
    <h2
      class="text-white font-display text-4xl md:text-6xl mb-6 tracking-tighter uppercase"
    >
      Conecta conmigo
    </h2>
    <p
      class="text-gray-500 font-satoshi max-w-lg mx-auto mb-10 text-sm md:text-base"
    >
      Soy un desarrollador apasionado por crear experiencias digitales únicas.
      ¿Te interesa colaborar o saber más de mi trabajo?
    </p>
    <div
      class="flex flex-col md:flex-row items-center justify-center gap-4 w-full px-4"
    >
      <a
        href="https://www.linkedin.com/in/marco-villanueva-ramirez-2b8631381/"
        target="_blank"
        class="w-full md:w-auto justify-center bg-white/5 border border-white/10 text-white hover:bg-[#0077b5] hover:border-[#0077b5] transition-all px-6 py-3 rounded-full flex items-center gap-2 font-satoshi font-medium text-sm"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="currentColor"
          stroke="none"
          ><path
            d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
          ></path></svg
        >
        LinkedIn
      </a>
      <a
        href="https://marcovillanueva.online/cv"
        target="_blank"
        class="w-full md:w-auto justify-center bg-white/5 border border-white/10 text-white hover:bg-white hover:text-black transition-all px-6 py-3 rounded-full flex items-center gap-2 font-satoshi font-medium text-sm"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line
            x1="8"
            y1="21"
            x2="16"
            y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg
        >
        Mi CV Web
      </a>
      <a
        href="mailto:marcoempresa159@gmail.com"
        class="w-full md:w-auto justify-center bg-white/5 border border-white/10 text-white hover:bg-[#f45d22] hover:border-[#f45d22] transition-all px-6 py-3 rounded-full flex items-center gap-2 font-satoshi font-medium text-sm"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path
            d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
          ></path><polyline points="22,6 12,13 2,6"></polyline></svg
        >
        marcoempresa159@gmail.com
      </a>
    </div>
  </div>

  <!-- Giant GSAP Animated Text -->
  <div
    class="w-full relative flex items-center justify-center overflow-hidden mb-12 select-none h-[20vw] mt-24"
  >
    <!-- Fondo LIFTLINK -->
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full text-center"
    >
      <div class="footer-huge-text">
        <h1
          class="font-satoshi text-[18vw] leading-none text-white tracking-tighter whitespace-nowrap opacity-[0.04]"
        >
          LIFTLINK
        </h1>
      </div>
    </div>
    <!-- Frente Marco Villanueva -->
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full text-center"
    >
      <div class="footer-huge-text">
        <h2
          class="font-satoshi text-[5vw] md:text-[5vw] leading-none text-white tracking-tighter whitespace-nowrap drop-shadow-2xl"
        >
          DESIGNED BY <span class="text-[#1A1DB9]">MARCO VILLANUEVA</span>
        </h2>
      </div>
    </div>
  </div>

  <!-- Small Footer -->
  <div
    class="w-full max-w-7xl mx-auto border-t border-white/10 pt-8 flex flex-col md:flex-row items-center justify-between z-10 gap-6"
  >
    <p class="text-gray-600 font-satoshi text-xs">© 2026 LiftLink</p>
    <div
      class="footer-badge bg-white/5 border border-white/10 px-5 py-2 rounded-full flex items-center gap-2"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="currentColor"
        ><path
          d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"
        ></path></svg
      >
      <span class="text-xs text-white font-satoshi font-bold tracking-wide"
        >Muy pronto en Google Play</span
      >
    </div>
  </div>
</footer>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    // Animación gigante del desarrollador
    gsap.fromTo(
      ".footer-huge-text",
      { y: 100, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 1.5,
        stagger: 0.2,
        ease: "power4.out",
        scrollTrigger: {
          trigger: "footer",
          start: "top 75%",
        },
      },
    );

    // Animación del botón Google Play
    gsap.fromTo(
      ".footer-badge",
      { opacity: 0, scale: 0.8, y: 30 },
      {
        opacity: 1,
        scale: 1,
        y: 0,
        duration: 1,
        delay: 0.4,
        ease: "back.out(1.5)",
        scrollTrigger: {
          trigger: "footer",
          start: "top 80%",
        },
      },
    );
  });
</script>
